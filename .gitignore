# ESP-IDF build output
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# python
__pycache__/
*.pyc

# local scratch: screenshots, temp plans, wait frames
*.log.tmp
pc/_*.json
pc/_wait_*.png
pc/shot.png
e2e_before.png
e2e_after.png

